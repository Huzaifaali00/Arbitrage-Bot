# ─────────────────────────────────────────────
# REQUIRED — fill every value marked <CHANGE_ME>
# ─────────────────────────────────────────────

# Chain selection: base | baseSepolia | arbitrum | arbitrumSepolia
CHAIN=baseSepolia

# RPC / WebSocket — Base mainnet
BASE_RPC_URL=https://mainnet.base.org
BASE_WS_URL=wss://base-rpc.publicnode.com

# Base Sepolia — kept for pre-launch smoke tests
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_WS_URL=wss://sepolia.base.org

# Hot-wallet private key — must include 0x prefix, 66 chars total
PRIVATE_KEY=<CHANGE_ME>

# ─────────────────────────────────────────────
# CONTRACT ADDRESSES  (re-fill after each deploy)
# ─────────────────────────────────────────────

CONTRACT_ADDRESS=<CHANGE_ME>
VAULT_ADDRESS=<CHANGE_ME>
DEX_REGISTRY_ADDRESS=<CHANGE_ME>

# ─────────────────────────────────────────────
# CHAIN-SPECIFIC CONSTANTS
# ─────────────────────────────────────────────

AAVE_POOL_ADDRESS=<CHANGE_ME>
PROFIT_TOKEN_ADDRESS=<CHANGE_ME>

# ─────────────────────────────────────────────
# TUNING
# ─────────────────────────────────────────────
LOG_LEVEL=info
MIN_PROFIT_BPS=20
MAX_GAS_PRICE=100
FLASH_LOAN_ENABLED=false
BATCH_OPERATIONS=true
MONITORING_INTERVAL=1000
BLACKLISTED_POOLS=
MAX_PLAUSIBLE_PROFIT_USD=10
MAX_TRADE_SIZE_USDC=5000000
MAX_TRADE_SIZE_WETH=10000000000000000
PERFORMANCE_FEE_BPS=2000

# ─────────────────────────────────────────────
# WEB PUSH NOTIFICATIONS (optional)
# Generate with: npx web-push generate-vapid-keys
# ─────────────────────────────────────────────
VAPID_PUBLIC_KEY=<CHANGE_ME>
VAPID_PRIVATE_KEY=<CHANGE_ME>
VAPID_SUBJECT=mailto:admin@example.com

# ── Anvil Fork Configuration ────────────────────────────────────────────────
# Set USE_ANVIL=true to point the bot at a local Anvil fork instead of live testnet.
# Start the fork with: bash scripts/start-anvil-fork.sh
# Get the fork block with: cast block-number --rpc-url $BASE_SEPOLIA_RPC_URL
USE_ANVIL=false
ANVIL_RPC_URL=http://127.0.0.1:8545
ANVIL_WS_URL=ws://127.0.0.1:8545
FORK_BLOCK_NUMBER=<CHANGE_ME>
# Anvil default account #0 — safe ONLY for local testing, never production
ANVIL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ANVIL_ACCOUNT=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
