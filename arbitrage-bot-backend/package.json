{
  "name": "arbitrage-bot-base",
  "version": "1.0.0",
  "description": "Enterprise-grade arbitrage bot for Base chain with all competitive strategies",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "monitor": "ts-node src/monitoring/dashboard.ts",
    "testnet": "LOG_LEVEL=debug CHAIN=baseSepolia FLASH_LOAN_ENABLED=false ts-node src/index.ts",
    "mainnet": "CHAIN=base ts-node src/index.ts",
    "anvil:start": "bash ../scripts/start-anvil-fork.sh",
    "anvil:seed": "ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/seed-anvil-pools.ts",
    "dev:anvil": "USE_ANVIL=true ts-node src/index.ts",
    "snapshot": "cast rpc evm_snapshot --rpc-url http://127.0.0.1:8545",
    "revert": "cast rpc evm_revert --rpc-url http://127.0.0.1:8545"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "base-x": "^4.0.0",
    "better-sqlite3": "^9.2.2",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.3.1",
    "ethers": "^6.10.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "socket.io": "^4.7.2",
    "web-push": "^3.6.7",
    "winston": "^3.11.0",
    "ws": "^8.15.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
